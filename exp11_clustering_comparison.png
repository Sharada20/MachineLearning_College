        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib\n",
        "matplotlib.use(\"Agg\")\n",
        "import matplotlib.pyplot as plt\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "from sklearn.cluster import KMeans, AgglomerativeClustering\n",
        "from sklearn.mixture import GaussianMixture\n",
        "from sklearn.metrics import silhouette_score, adjusted_rand_score\n",
        "from scipy.cluster.hierarchy import dendrogram, linkage\n",
        "\n",
        "# ---- Load dataset ----\n",
        "df = pd.read_csv(\"/content/iris.csv\")\n",
        "X = df.drop(columns=['species'])\n",
        "y_true = df['species']\n",
        "scaler = StandardScaler()\n",
        "X_scaled = scaler.fit_transform(X)\n",
        "\n",
        "# =========================================================\n",
        "# 1. K-Means Clustering\n",
        "# =========================================================\n",
        "kmeans = KMeans(n_clusters=3, random_state=42, n_init=10)\n",
        "kmeans_labels = kmeans.fit_predict(X_scaled)\n",
        "\n",
        "print(\"=\" * 60)\n",
        "print(\"K-MEANS CLUSTERING\")\n",
        "print(\"=\" * 60)\n",
        "print(f\"Cluster centers (scaled space):\\n{kmeans.cluster_centers_}\")\n",
        "\n",
        "print(f\"Silhouette Score: {silhouette_score(X_scaled, kmeans_labels):.4f}\")\n",
        "print(f\"Adjusted Rand Index vs true labels: {adjusted_rand_score(y_true, kmeans_labels):.4f}\")\n",
        "\n",
        "# =========================================================\n",
        "# 2. Gaussian Mixture Model (mixtures of Gaussians)\n",
        "# =========================================================\n",
        "gmm = GaussianMixture(n_components=3, random_state=42)\n",
        "gmm_labels = gmm.fit_predict(X_scaled)\n",
        "\n",
        "print(\"\\n\" + \"=\" * 60)\n",
        "print(\"GAUSSIAN MIXTURE MODEL (GMM)\")\n",
        "print(\"=\" * 60)\n",
        "print(f\"Converged: {gmm.converged_}\")\n",
        "print(f\"Silhouette Score: {silhouette_score(X_scaled, gmm_labels):.4f}\")\n",
        "print(f\"Adjusted Rand Index vs true labels: {adjusted_rand_score(y_true, gmm_labels):.4f}\")\n",
        "\n",
        "# =========================================================\n",
        "# 3. Hierarchical (Agglomerative) Clustering\n",
        "# =========================================================\n",
        "hier = AgglomerativeClustering(n_clusters=3, linkage='ward')\n",
        "hier_labels = hier.fit_predict(X_scaled)\n",
        "\n",
        "print(\"\\n\" + \"=\" * 60)\n",
        "print(\"HIERARCHICAL (AGGLOMERATIVE) CLUSTERING\")\n",
        "print(\"=\" * 60)\n",
        "print(f\"Silhouette Score: {silhouette_score(X_scaled, hier_labels):.4f}\")\n",
        "print(f\"Adjusted Rand Index vs true labels: {adjusted_rand_score(y_true, hier_labels):.4f}\")\n",
        "\n",
        "# ---- Dendrogram ----\n",
        "plt.figure(figsize=(10, 6))\n",
        "Z = linkage(X_scaled, method='ward')\n",
        "dendrogram(Z, truncate_mode='level', p=5)\n",
        "plt.title(\"Hierarchical Clustering Dendrogram (Ward linkage)\")\n",
        "plt.xlabel(\"Sample index / cluster size\")\n",
        "plt.ylabel(\"Distance\")\n",
        "plt.tight_layout()\n",
        "plt.savefig(\"exp5_dendrogram.png\", dpi=150)\n",
        "print(\"\\nDendrogram saved as exp5_dendrogram.png\")\n",
        "\n",
        "# ---- Scatter plot comparison (first two features) ----\n",
        "fig, axes = plt.subplots(1, 3, figsize=(16, 5))\n",
        "for ax, labels, title in zip(\n",
        "    axes, [kmeans_labels, gmm_labels, hier_labels],\n",
        "    [\"K-Means\", \"Gaussian Mixture\", \"Hierarchical\"]\n",
        "):\n",
        "    ax.scatter(X_scaled[:, 0], X_scaled[:, 1], c=labels, cmap='viridis', s=30)\n",
        "    ax.set_title(title)\n",
        "    ax.set_xlabel(\"Sepal length (scaled)\")\n",
        "    ax.set_ylabel(\"Sepal width (scaled)\")\n",
        "plt.tight_layout()\n",
        "plt.savefig(\"exp5_clustering_comparison.png\", dpi=150)\n",
        "\n",
        "print(\"Comparison plot saved as exp5_clustering_comparison.png\")"
      ]
    }
  ]
}