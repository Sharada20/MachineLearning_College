      "source": [
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "from sklearn.decomposition import PCA\n",
        "\n",
        "# ---- Load dataset ----\n",
        "df = pd.read_csv(\"/content/iris.csv\")\n",
        "X = df.drop(columns=['species'])\n",
        "y = df['species']\n",
        "\n",
        "# ---- Standardize the features ----\n",
        "scaler = StandardScaler()\n",
        "X_scaled = scaler.fit_transform(X)\n",
        "\n",
        "# =========================================================\n",
        "# PCA with all components (to inspect explained variance)\n",
        "# =========================================================\n",
        "pca_full = PCA()\n",
        "pca_full.fit(X_scaled)\n",
        "\n",
        "print(\"=\" * 60)\n",
        "print(\"Explained variance ratio per component:\")\n",
        "print(\"=\" * 60)\n",
        "for i, ratio in enumerate(pca_full.explained_variance_ratio_, start=1):\n",
        "    print(f\"PC{i}: {ratio:.4f}\")\n",
        "\n",
        "print(\"\\nCumulative explained variance:\")\n",
        "print(np.cumsum(pca_full.explained_variance_ratio_))\n",
        "\n",
        "# =========================================================\n",
        "# Reduce to 2 principal components for visualization\n",
        "# =========================================================\n",
        "pca = PCA(n_components=2)\n",
        "X_pca = pca.fit_transform(X_scaled)\n",
        "\n",
        "print(\"\\n\" + \"=\" * 60)\n",
        "print(f\"Total variance explained by 2 components: {sum(pca.explained_variance_ratio_):.4f}\")\n",
        "print(\"=\" * 60)\n",
        "\n",
        "pca_df = pd.DataFrame(X_pca, columns=['PC1', 'PC2'])\n",
        "pca_df['species'] = y\n",
        "\n",
        "print(\"\\nFirst 5 rows of PCA-transformed data:\")\n",
        "print(pca_df.head())\n",
        "\n",
        "# ---- Scree plot ----\n",
        "plt.figure(figsize=(7, 5))\n",
        "plt.plot(range(1, len(pca_full.explained_variance_ratio_) + 1),\n",
        "         pca_full.explained_variance_ratio_, marker='o', linestyle='--')\n",
        "plt.xlabel(\"Principal Component\")\n",
        "plt.ylabel(\"Explained Variance Ratio\")\n",
        "plt.title(\"Scree Plot\")\n",
        "plt.tight_layout()\n",
        "plt.savefig(\"exp6_scree_plot.png\", dpi=150)\n",
        "plt.show() # Display the plot in the notebook\n",
        "\n",
        "# ---- 2D scatter plot of PCA components ----\n",
        "plt.figure(figsize=(8, 6))\n",
        "for species in pca_df['species'].unique():\n",
        "    subset = pca_df[pca_df['species'] == species]\n",
        "    plt.scatter(subset['PC1'], subset['PC2'], label=species, s=40)\n",
        "plt.xlabel(\"Principal Component 1\")\n",
        "plt.ylabel(\"Principal Component 2\")\n",
        "plt.title(\"PCA of Iris Dataset (2 Components)\")\n",
        "plt.legend()\n",
        "plt.tight_layout()\n",
        "plt.savefig(\"exp6_pca_scatter.png\", dpi=150)\n",
        "plt.show() # Display the plot in the notebook\n",
        "\n",
        "print(\"\\nPlots saved: exp6_scree_plot.png, exp6_pca_scatter.png\")"
      ]
    }
  ]
